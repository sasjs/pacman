{
  "$schema": "https://raw.githubusercontent.com/sasjs/utils/main/src/types/sasjsconfig-schema.json",
  "streamConfig": {
    "streamWeb": true,
    "streamWebFolder": "web",
    "webSourcePath": "src",
    "streamServiceName": "Pacman",
    "streamLogo": "pacman.png"
  },
  "defaultTarget": "server",
  "targets": [
    {
      "name": "viya",
      "serverUrl": "",
      "serverType": "SASVIYA",
      "appLoc": "/Public/app/pacman",
      "contextName": "SAS Job Execution compute context"
    },
    {
      "name": "sas9",
      "serverUrl": "",
      "serverType": "SAS9",
      "appLoc": "/Public/app/pacman",
      "serverName": "SASApp",
      "repositoryName": "Foundation"
    },
    {
      "name": "server",
      "serverUrl": "",
      "serverType": "SASJS",
      "appLoc": "/Public/app/pacman",
      "streamConfig": {
        "streamWeb": true,
        "streamWebFolder": "web",
        "webSourcePath": "src",
        "streamServiceName": "Pacman",
        "streamLogo": "pacman.png",
        "mockWeb": true,
        "mockWebFolder": "sasjsbuild/mock"
      },
      "deployConfig": {
        "deployServicePack": true
      }
    }
  ],
  "release": {
    "assets": [
      {
        "path": "artefacts/server.json.zip",
        "label": "SASjs Streamed App (Zip File)"
      },
      {
        "path": "artefacts/sas9.sas",
        "label": "SAS 9 EBI Deployment (SAS Program)"
      },
      {
        "path": "artefacts/viya.sas",
        "label": "Viya Deployment (SAS Program)"
      }
    ]
  }
}
